# Copy to .env.local: `cp .env.example .env.local`

# URL of the api-gc backend. Public: it reaches the browser, never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional absolute API origin for server requests, image optimization and the /api proxy.
# On Vercel: NEXT_PUBLIC_API_URL=/api and API_UPSTREAM_URL=https://api-cg.lumarsoft.com.
API_UPSTREAM_URL=
